# Runtime classification is separate from NODE_ENV: local production builds use APP_ENV=local.
NODE_ENV=development
APP_ENV=local
PORT=3001
BIND_ADDRESS=0.0.0.0
DATABASE_URL=postgresql://proview:proview_local@127.0.0.1:5432/proview?schema=public
POSTGRES_USER=proview
POSTGRES_PASSWORD=proview_local
POSTGRES_DB=proview
JWT_ACCESS_SECRET=local-only-replace-this-64-character-secret-before-any-deployment-123
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
TRUST_PROXY=false
ENABLE_API_DOCS=true
SEED_DEMO=false
PROVIEW_API_INTERNAL_URL=http://127.0.0.1:3001
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=../../.data/files
MAX_UPLOAD_BYTES=20971520
# S3/MinIO must remain private. Production should use a scoped application identity.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=proview-private
S3_ACCESS_KEY_ID=proview_local
S3_SECRET_ACCESS_KEY=proview_local_storage_password
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=proview_local
MINIO_ROOT_PASSWORD=proview_local_storage_password
LOCAL_PROXY_PORT=8080
