{
  "name": "@proview/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test prisma/*.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "db:generate": "node scripts/prisma.cjs generate",
    "db:migrate": "node scripts/prisma.cjs migrate deploy",
    "db:seed": "node scripts/prisma.cjs db seed"
  },
  "prisma": { "seed": "node --import tsx prisma/seed.ts" },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1147.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@prisma/client": "6.19.3",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
    "cookie-parser": "1.4.7",
    "csv-parse": "7.0.3",
    "dotenv": "17.2.3",
    "helmet": "8.1.0",
    "multer": "2.0.2",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@proview/config": "workspace:*",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.0.0",
    "@types/node": "24.19.1",
    "@types/pg": "8.16.0",
    "@types/supertest": "6.0.3",
    "nodemon": "3.1.14",
    "prisma": "6.19.3",
    "supertest": "7.3.1",
    "ts-node": "10.9.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
